PORT=7720
HOST=127.0.0.1
DEMO_MODE=mock
# Real mode (Phase 2, owner-run): copy the shared settings keys into ~/Development/.env, not here.
# This app reads (never writes) PINGONE_* keys from the shared settings file; see docs/talk-track.md.
# Run observability (rule 27), Real mode only. Empty by default. A LOOPBACK Elasticsearch origin (a port-forward, for example
# http://127.0.0.1:9200) and a READ-ONLY API key the owner creates. Inside the container loopback is the container itself: use a
# forwarder in the lab's network namespace. Never mount the Docker socket (RUN_OBS_DOCKER=1 is for a throwaway ad-hoc override only).
RUN_OBS_ES_URL=
RUN_OBS_ES_READ_APIKEY=
