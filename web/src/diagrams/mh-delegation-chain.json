  },
  "nodes": [
    { "id": "jordan", "group": "person", "label": "{{cast.personShort}}", "sub": ["Signs in once", "Never sees a token"], "x": 0, "y": 200 },
    { "id": "external", "group": "platform", "label": "External agent ({{cast.platform}})", "sub": ["Third-party signed JWT", "Trust established at the AS"], "x": 0, "y": 20 },
    { "id": "as", "group": "as", "label": "Authorization server", "sub": ["Exchanges: subject + actor", "Mints the act claim"], "x": 300, "y": 110 },
    { "id": "concierge", "group": "agent", "label": "{{cast.agent}}", "sub": ["Holds the person token", "Picks the specialist"], "x": 300, "y": 290 },
    { "id": "payouts", "group": "agent", "label": "{{cast.specialistPayouts}}", "sub": ["scope mp:payouts", "Its own door"], "x": 640, "y": 200 },
    { "id": "payments", "group": "agent", "label": "{{cast.specialistPayments}}", "sub": ["scope mp:payments", "Its own door"], "x": 640, "y": 360 },
    { "id": "payouts-door", "group": "door", "label": "Payouts door", "sub": ["Required claims: act.sub, client_id"], "x": 900, "y": 200 },
